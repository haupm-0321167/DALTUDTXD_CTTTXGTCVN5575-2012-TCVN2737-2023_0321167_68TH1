<Window x:Class="DALTUDTXD_CTTTXaGo_0321167_68TH1.Views.POPUP_KA.KiemTraDieuKienBenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DALTUDTXD_CTTTXaGo_0321167_68TH1.Views.POPUP_KA"
        mc:Ignorable="d"
            Title="Kiểm Tra Điều Kiện Bền" Height="500" Width="820"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>


        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Value="#047857" Property="Background"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid  Margin="15">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/background.png"
Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#2A4B3D" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <TextBlock Text="CHƯƠNG TRÌNH TÍNH TOÁN XÀ GỒ - KIỂM TRA ĐIỀU KIỆN BỀN"
                       FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>


        <Border Grid.Row="1" Style="{StaticResource GroupCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mác thép chế tạo:" Style="{StaticResource FormLabelStyle}"/>
                <ComboBox Grid.Column="1" x:Name="cbb_LoaiThep" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="cbb_LoaiThep_SelectionChanged">
                    <ComboBoxItem Content="Thép Nhật JIS G3101:SS400"/>
                    <ComboBoxItem Content="Thép Nhật JIS G3302:G350"/>
                    <ComboBoxItem Content="Thép Nhật JIS G3302:G450"/>
                    <ComboBoxItem Content="Thép Nhật JIS G3302:G550"/>
                    <ComboBoxItem Content="Thép Trung Quốc Q235"/>
                    <ComboBoxItem Content="Thép Trung Quốc Q345"/>
                    <ComboBoxItem Content="Thép Trung Quốc Q390"/>
                    <ComboBoxItem Content="Thép Hoa Kỳ A36"/>
                    <ComboBoxItem Content="Thép Hoa Kỳ A570"/>
                </ComboBox>
            </Grid>
        </Border>


        <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
</Window>
