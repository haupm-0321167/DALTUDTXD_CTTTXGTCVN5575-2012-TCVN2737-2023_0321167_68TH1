                            <TextBlock Grid.Column="0" Text="TỔNG HOẠT TẢI TÍNH TOÁN (kg/m):" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBox Grid.Column="1" x:Name="txt_TongHoatTai" FontWeight="ExtraBold" Foreground="#065F46" Background="#ECFDF5" Height="32" TextAlignment="Center" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </ScrollViewer>




</Window>
