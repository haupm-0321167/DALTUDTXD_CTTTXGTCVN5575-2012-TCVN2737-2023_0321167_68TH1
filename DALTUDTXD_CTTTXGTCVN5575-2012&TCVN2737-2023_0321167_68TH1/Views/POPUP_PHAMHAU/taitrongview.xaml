<Window x:Class="DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.POPUP_PHAMHAU.taitrongview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.POPUP_PHAMHAU"
            Width="850" Height="780"
    Title="Tính Toán Tải Trọng"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>


        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Value="#047857" Property="Background"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Value="#047857" Property="Background"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
        <Grid Background="#F8FAFC" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="15,12" Margin="0,0,0,15">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="step1Circle" Width="28" Height="28" CornerRadius="14" Background="#059669" VerticalAlignment="Center">
                            <TextBlock x:Name="step1CircleText" Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="step1Text" Text=" TẢI TRỌNG GIÓ" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#065F46" Margin="8,0,0,0"/>
                    </StackPanel>


                    <Border Grid.Column="1" Height="2" Background="#E2E8F0" VerticalAlignment="Center" Margin="10,0"/>


                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="step2Circle" Width="28" Height="28" CornerRadius="14" Background="#E2E8F0" VerticalAlignment="Center">
                            <TextBlock x:Name="step2CircleText" Text="2" Foreground="#64748B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="step2Text" Text=" TĨNH TẢI MÁI" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,0"/>
                    </StackPanel>


                    <Border Grid.Column="3" Height="2" Background="#E2E8F0" VerticalAlignment="Center" Margin="10,0"/>


                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="step3Circle" Width="28" Height="28" CornerRadius="14" Background="#E2E8F0" VerticalAlignment="Center">
                            <TextBlock x:Name="step3CircleText" Text="3" Foreground="#64748B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="step3Text" Text=" HOẠT TẢI MÁI" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,12,0">

                <Grid x:Name="grid_Step1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2A4B3D" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <TextBlock Text="BƯỚC 1: TÍNH TOÁN TẢI TRỌNG GIÓ TÁC DỤNG LÊN XÀ GỒ"
                        FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0" Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN CÔNG TRÌNH" FontWeight="Bold" FontSize="13" Foreground="#065F46" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Tỉnh:" Grid.Row="0" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbb_tinh" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="cbb_tinh_SelectionChanged"/>

                                    <TextBlock Text="Q.Huyện:" Grid.Row="1" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbb_huyen" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="cbb_huyen_SelectionChanged"/>

                                    <TextBlock Text="X.Phường:" Grid.Row="2" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cbb_phuong" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Cbb_phuong_SelectionChanged"/>

                                    <TextBlock Text="Vùng gió:" Grid.Row="3" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt_vunggio" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"/>

                                    <TextBlock Text="Địa hình:" Grid.Row="4" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txt_diahinh" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"/>

                                    <TextBlock Text="Loại nhà:" Grid.Row="5" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cbb_loainha" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="TinhZe_Auto">
                                        <ComboBoxItem Content="Nhà mái bằng"/>
                                        <ComboBoxItem Content="Nhà 1 mái dốc"/>
                                        <ComboBoxItem Content="Nhà 2 mái dốc"/>
                                        <ComboBoxItem Content="Nhà mái vòm"/>

                                    </ComboBox>

                                    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Margin="0,5,0,0" Content="Có tường chắn mái" IsChecked="True" FontWeight="SemiBold" Foreground="#475569"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    

                    <Border Grid.Column="2" Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="THÔNG SỐ THIẾT KẾ" FontWeight="Bold" FontSize="13" Foreground="#065F46" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Áp lực gió W0:" Grid.Row="0" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" x:Name="txt_aplucgio" Style="{StaticResource FormTextBoxStyle}"/>



                                    <TextBlock Text="Cao độ Ze (m):" Grid.Row="1" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Width="120" x:Name="txt_ze" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"/>

                                    <TextBlock Text="Bước xà gồ (m):" Grid.Row="2" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="120" x:Name="txt_buocxago" Style="{StaticResource FormTextBoxStyle}" Text=""/>

                                    <TextBlock Text="Nhịp xà gồ (m):" Grid.Row="3" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Width="120" x:Name="txt_NhipXaGo" Style="{StaticResource FormTextBoxStyle}"/>

                                    <TextBlock Text="Độ dốc mái:" Grid.Row="4" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Width="120" x:Name="txt_DoDocMai" Style="{StaticResource FormTextBoxStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="THÔNG SỐ MÁI &amp; TẢI" FontWeight="Bold" FontSize="13" Foreground="#065F46" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock Text="Số ty treo xà gồ:" Grid.Row="0" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" x:Name="txt_SoTyTreoXaGoMai" Style="{StaticResource FormTextBoxStyle}"/>

                                    <TextBlock Text="Vùng tính gió:" Grid.Row="1" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Width="120" x:Name="cbb_vunggio" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="Tinhc_Auto">
                                        <ComboBoxItem Content="Vùng A"/>
                                        <ComboBoxItem Content="Vùng B"/>
                                        <ComboBoxItem Content="Vùng C"/>
                                        <ComboBoxItem Content="Vùng F"/>
                                        <ComboBoxItem Content="Vùng G"/>
                                        <ComboBoxItem Content="Vùng H"/>
                                        <ComboBoxItem Content="Vùng I"/>
                                        <ComboBoxItem Content="Vùng J"/>
                                        <ComboBoxItem Content="-"/>
                                    </ComboBox>

                                    <TextBlock Text="Cấp công trình:" Grid.Row="2" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox Grid.Row="2" 
                                          Grid.Column="1" 
                                          Width="120"
                                          x:Name="cbb_capcongtrinh" 
                                          Style="{StaticResource FormComboBoxStyle}" SelectionChanged="TinhgammaT_Auto">
                                        <ComboBoxItem Content="Công trình bình thường"/>
                                        <ComboBoxItem Content="Công trình quan trọng"/>
                                        <ComboBoxItem Content="Công trình đặc biệt"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="HỆ SỐ TÍNH TOÁN TRUNG GIAN" FontWeight="Bold" FontSize="13" Foreground="#065F46" Margin="0,0,0,10"/>
                            <UniformGrid Columns="5">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="k(Ze)" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="txt_kze" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Hệ số khí động c" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="txt_c" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Hệ số tin cậy γT" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="txt_gammaT" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Hệ số Gf" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}" Text="0.850"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="Hệ số γf" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}" Text="2.1"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>


                    <Border Grid.Row="3" Style="{StaticResource GroupCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <Border Background="#ECFDF5" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center"
                           Text="Công thức tính: W = B × W0 × k(Ze) × c × Gf × γT × γf (với γf = 2.1)"/>
                                </Border>


                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12" BorderBrush="#DCFCE7" BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Run Text="Tải Trọng Gió Tính Toán: " FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                    <Run x:Name="txt_ketqua" Text="-- kg/m" FontSize="18" FontWeight="ExtraBold" Foreground="#16A34A"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Content="TÍNH TẢI TRỌNG GIÓ" Click="btn_tinhtoan_Click" Style="{StaticResource PrimaryButtonStyle}" Height="60" Margin="15,0,0,0"/>
                        </Grid>
                    </Border>


                </Grid>
                <Grid x:Name="grid_Step2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2A4B3D" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <TextBlock Text="BƯỚC 2: KHAI BÁO TĨNH TẢI TÁC DỤNG LÊN XÀ GỒ"
                   FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>


                    <Border Grid.Row="1" Style="{StaticResource GroupCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="TĨNH TẢI TÁC DỤNG (DEAD LOAD - TT)" FontWeight="Bold" FontSize="14" Foreground="#065F46" Margin="0,0,0,10"/>

                            <DataGrid x:Name="dgTinhTai"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      Background="White"
                      BorderThickness="1"
                      BorderBrush="#E2E8F0"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F8FAFC"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="32">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#10B981"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#059669"/>
                                        <Setter Property="Height" Value="28"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Vật liệu mái" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TenVatLieu}" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding TenVatLieu}" SelectionChanged="VatLieu_Changed">
                                                    <ComboBoxItem>Tôn sóng</ComboBoxItem>
                                                    <ComboBoxItem>Tôn PU</ComboBoxItem>
                                                    <ComboBoxItem>Trần treo</ComboBoxItem>
                                                    <ComboBoxItem>Trần thạch cao</ComboBoxItem>

                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="gtc (kg/m²)" Binding="{Binding Gtc}" Width="100"/>
                                    <DataGridTextColumn Header="Hệ số n1" Binding="{Binding N1}" Width="100"/>
                                    <DataGridTextColumn Header="Bước B (m)" Binding="{Binding B}" Width="100"/>
                                    <DataGridTextColumn Header="Gtt (kg/m)" Binding="{Binding Gtt, StringFormat=0.##}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,5,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>


                    <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TỔNG TĨNH TẢI TÍNH TOÁN (kg/m):" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBox Grid.Column="1" x:Name="txt_TongTinhTai" FontWeight="ExtraBold" Foreground="#065F46" Background="#ECFDF5" Height="32" TextAlignment="Center" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="grid_Step3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <Border Grid.Row="0" Background="#2A4B3D" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <TextBlock Text="BƯỚC 3: KHAI BÁO HOẠT TẢI SỬA CHỮA MÁI"
                       FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>


                    <Border Grid.Row="1" Style="{StaticResource GroupCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="HOẠT TẢI SỬA CHỮA MÁI (LIVE LOAD - HT)" FontWeight="Bold" FontSize="14" Foreground="#065F46" Margin="0,0,0,10"/>

                            <DataGrid x:Name="dgHoatTai"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          Background="White"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="32">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#10B981"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#059669"/>
                                        <Setter Property="Height" Value="28"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Loại hoạt tải mái" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LoaiHoatTai}" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding LoaiHoatTai}" SelectionChanged="LoaiHoatTai_Changed">
                                                    <ComboBoxItem>Sửa chữa mái</ComboBoxItem>
                                                    <ComboBoxItem>Bảo dưỡng</ComboBoxItem>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="ptc (kg/m²)" Binding="{Binding Ptc}" Width="100"/>
                                    <DataGridTextColumn Header="Hệ số n2" Binding="{Binding N2}" Width="100"/>
                                    <DataGridTextColumn Header="Bước B (m)" Binding="{Binding B}" Width="100"/>
                                    <DataGridTextColumn Header="Ptt (kg/m)" Binding="{Binding Ptt, StringFormat=0.##}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,5,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>


                    <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
