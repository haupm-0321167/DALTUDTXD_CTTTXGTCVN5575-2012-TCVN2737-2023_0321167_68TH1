<Window x:Class="DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.POPUP_PHAMHAU.Emailview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.POPUP_PHAMHAU"
                mc:Ignorable="d"
        Title="Email" Height="600" Width="800">
    <Window.Resources>

        <Style x:Key="ModernGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Value="#047857" Property="Background"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid >
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/background.png"
Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#2A4B3D" Height="55" Padding="20,0">
            <TextBlock Text="GỬI BÁO CÁO LỖI &amp; YÊU CẦU HỖ TRỢ KỸ THUẬT"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ModernGroupCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Row="0" Grid.Column="0" Text="Email người gửi:" Style="{StaticResource SidebarLabelStyle}" Margin="5,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="5,10" x:Name="txt_From"
                         Text=""
                         Style="{StaticResource FormTextBoxStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email người nhận:" Style="{StaticResource SidebarLabelStyle}" Margin="5,10"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="5,10" x:Name="cbb_To" Height="35" VerticalContentAlignment="Center" Padding="10,5">
                    <ComboBoxItem Content="haudz24052003@gmail.com (Quản lý PM)" IsSelected="True"/>
                    <ComboBoxItem Content="anhthi2082005@gmail.com (Quản lý Hiển thị)"/>
                    <ComboBoxItem Content="nguyenkimanh2005123@gmail.com (Quản lý Thiết kế)"/>
                </ComboBox>


                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tiêu đề:" Style="{StaticResource SidebarLabelStyle}" Margin="5,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="5,10" x:Name="txt_Subject"
                         Text="Báo cáo lỗi &amp; Góp ý cải tiến phần mềm thiết kế xà gồ"
                         Style="{StaticResource FormTextBoxStyle}"/>


                <TextBlock Grid.Row="3" Grid.Column="0" Text="Nội dung phản hồi:" Style="{StaticResource SidebarLabelStyle}" Margin="5,10" VerticalAlignment="Top"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="5,10" x:Name="txt_Body"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="Kính gửi Ban Dự Án,&#x0a;&#x0a;Tôi muốn báo cáo ý kiến góp ý như sau:&#x0a;- ...&#x0a;- ...&#x0a;&#x0a;Trân trọng cảm ơn!"
                         Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>


                <Button Grid.Row="4" Grid.Column="1" Content="GỬI EMAIL PHẢN HỒI" Margin="5,20,5,5"
                        Style="{StaticResource PrimaryButtonStyle}" Click="SendEmail_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
