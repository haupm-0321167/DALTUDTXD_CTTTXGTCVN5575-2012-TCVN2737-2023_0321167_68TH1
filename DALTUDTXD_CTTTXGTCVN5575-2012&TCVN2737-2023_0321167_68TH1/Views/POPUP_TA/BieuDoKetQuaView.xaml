<Window x:Class="DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.POPUP_TA.BieuDoKetQuaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.POPUP_TA"
        mc:Ignorable="d"
    Title="BIỂU ĐỒ NỘI LỰC CHI TIẾT" Height="750" Width="1250"
    WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Window.Resources>

        <Style x:Key="ModernGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>


        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Value="#1D4ED8" Property="Background"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/background.png"
Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#2A4B3D" Height="55" Padding="20,0">
            <TextBlock x:Name="lblHeaderTitle" Text="BIỂU ĐỒ NỘI LỰC CHI TIẾT XÀ GỒ"
                       Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0" Style="{StaticResource ModernGroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="THÔNG SỐ THIẾT KẾ &amp; TẢI TRỌNG" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>


                        <TextBlock Text="Loại biểu đồ:" Style="{StaticResource SidebarLabelStyle}"/>
                        <ComboBox x:Name="cbbDiagType" Margin="0,0,0,10" Height="30" VerticalContentAlignment="Center" SelectionChanged="Param_SelectionChanged">
                            <ComboBoxItem Content="Biểu đồ Moment (My)" Tag="Moment" IsSelected="True"/>
                            <ComboBoxItem Content="Biểu đồ Lực cắt (V)" Tag="Shear"/>
                            <ComboBoxItem Content="Biểu đồ Độ võng (f)" Tag="Deflection"/>
                        </ComboBox>


                        <TextBlock Text="Tổ hợp tải trọng:" Style="{StaticResource SidebarLabelStyle}"/>
                        <ComboBox x:Name="cbbCombo" Margin="0,0,0,10" Height="30" VerticalContentAlignment="Center" SelectionChanged="Combo_SelectionChanged"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số nhịp:" Style="{StaticResource SidebarLabelStyle}"/>
                                <ComboBox x:Name="cbbSpans" Height="30" VerticalContentAlignment="Center" SelectionChanged="Param_SelectionChanged">
                                    <ComboBoxItem Content="1 nhịp" Tag="1"/>
                                    <ComboBoxItem Content="2 nhịp" Tag="2"/>
                                    <ComboBoxItem Content="3 nhịp" Tag="3"/>
                                    <ComboBoxItem Content="4 nhịp" Tag="4"/>
                                    <ComboBoxItem Content="5 nhịp" Tag="5" IsSelected="True"/>
                                    <ComboBoxItem Content="6 nhịp" Tag="6"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nhịp chi tiết:" Style="{StaticResource SidebarLabelStyle}"/>
                                <ComboBox x:Name="cbbActiveSpan" Height="30" VerticalContentAlignment="Center" SelectionChanged="ActiveSpan_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nhịp L (m):" Style="{StaticResource SidebarLabelStyle}"/>
                                <TextBox x:Name="txtL" Text="7.00" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tải q (kN/m):" Style="{StaticResource SidebarLabelStyle}"/>
                                <TextBox x:Name="txtQ" Text="10.00" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="CẬP NHẬT PHÂN TÍCH" Style="{StaticResource PrimaryButtonStyle}" Click="Update_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ModernGroupCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="BẢNG TỌA ĐỘ GIÁ TRỊ CHI TIẾT" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1" x:Name="dgValues" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="White" RowHeaderWidth="0" SelectionChanged="dgValues_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tọa độ X (mm)" Binding="{Binding X_mm}" Width="*"/>
                                <DataGridTextColumn x:Name="colValueHeader" Header="Giá trị" Binding="{Binding ValueFormatted}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0" Style="{StaticResource ModernGroupCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="BIỂU ĐỒ TOÀN BỘ DẦM LIÊN TỤC (OVERVIEW)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" BorderThickness="1" BorderBrush="#CBD5E1">
                            <Canvas x:Name="canvasOverview" Background="#0F172A" SizeChanged="Canvas_SizeChanged"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource ModernGroupCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="lblDetailTitle" Text="BIỂU ĐỒ CHI TIẾT NHỊP 1" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" BorderThickness="1" BorderBrush="#CBD5E1">
                            <Canvas x:Name="canvasDetail" Background="#0F172A" SizeChanged="Canvas_SizeChanged" MouseLeftButtonDown="canvasDetail_MouseLeftButtonDown"/>
                        </Border>
                    </Grid>
                </Border>


                <Border Grid.Row="2" Style="{StaticResource ModernGroupCardStyle}" Height="60" Margin="6,3,6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0 mm" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        <Slider Grid.Column="1" x:Name="sliderX" Minimum="0" Maximum="7000" Value="3500" 
                                VerticalAlignment="Center" ValueChanged="sliderX_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="lblMaxSpanX" Text="7000 mm" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#2A4B3D" Height="40" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblCoordinateInfo" Text="Tọa độ x = 3500 mm | Giá trị uốn My = 0.00 kNm" 
                           Foreground="#34D399" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="Nhấp chuột trên đồ thị hoặc kéo Slider để tra cứu" 
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
