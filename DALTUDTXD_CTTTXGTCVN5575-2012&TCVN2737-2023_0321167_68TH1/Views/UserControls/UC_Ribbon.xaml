<UserControl x:Class="DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.UserControls.UC_Ribbon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DALTUDTXD_CTTTXGTCVN5575_2012_TCVN2737_2023_0321167_68TH1.Views.UserControls"
        mc:Ignorable="d"
         Height="150" Width="800">
    <Grid>
        <Ribbon Grid.Row="0" SelectedIndex="1" Background="#FFDDE7F4">
            <RibbonTab Header="Hiển thị">
                <RibbonGroup Header="Chế độ hiển thị">
                    <RibbonButton Label="Chế độ 3D"
                                  Click="Btn3D_Click"
                                  LargeImageSource="/Assets/Icons/3D.png" />
                    <RibbonButton Label="Chế độ12D"
                                  Click="Btn2D_Click"
                                  LargeImageSource="/Assets/Icons/2D.png" />

                </RibbonGroup>

                <RibbonGroup Header="Mặt bằng">
                    <RibbonButton Label="Mặt bằng 2D"
                                  Click="BtnMatbang2D_Click"
                                  LargeImageSource="/Assets/Icons/matbang2D.png" />

                </RibbonGroup>
                <RibbonGroup Header="Mô hình">
                    <RibbonButton Label="Mặt cắt xà gồ"
                                  Click="BtnMatcatxago_Click"
                                  LargeImageSource="/Assets/Icons/tinhphanlucgoi.png" />

                </RibbonGroup>

                <RibbonGroup Header="Biểu đồ nội lực">
                    <RibbonButton Label="Biểu đồ Moment"
                                  Click="BtnMoment_Click"
                                  LargeImageSource="/Assets/Icons/bieudonoiluc.png" />
                    <RibbonButton Label="Biểu đồ Lực cắt"
                                  Click="BtnBieudoluccat_Click"
                                  LargeImageSource="/Assets/Icons/noiluc.png" />
                    <RibbonButton Label="Biểu đồ Độ võng"
                                  Click="BtnBieudodovong_Click"
                                  LargeImageSource="/Assets/Icons/tinhdovong.png" />

                </RibbonGroup>
                
            </RibbonTab>
            <RibbonTab Header="Trợ giúp">
                <RibbonGroup Header="Help">
                    <RibbonButton x:Name="rbt_trogiup" Label="Trợ giúp" 
                                  SmallImageSource="/Assets/Icons/trogiup.png"/>
                    <RibbonButton x:Name="rbt_huongdan" Label="Hướng dẫn" 
                                  SmallImageSource="/Assets/Icons/huongdan.png"/>
                </RibbonGroup>
                <RibbonGroup Header="Hỗ trợ kỹ thuật">
                    <RibbonButton x:Name="rbt_Email" Label="Email hỗ trợ"
                                  Click="rbt_Email_Click"
                                  SmallImageSource="/Assets/Icons/email.png"/>
                    <RibbonButton x:Name="rbt_Lienhe" Label="Liên hệ" 
                                  Click="rbt_Lienhe_Click"
                                  SmallImageSource="/Assets/Icons/contact-mail.png" />
                    <RibbonButton x:Name="rbt_Baoloi" Label="Báo lỗi" 
                                  Click="rbt_Baoloi_Click"
                                   SmallImageSource="/Assets/Icons/bug-report.png"/>
                </RibbonGroup>
                <RibbonGroup Header="Hướng dẫn sử dụng">
                    <RibbonButton x:Name="rbt_Huongdan" Label="Hướng dẫn chi tiết" 
                                  SmallImageSource="/Assets/Icons/information.png"/>
                    <RibbonButton x:Name="rbt_Videohuongdan" Label="Video hướng dẫn" 
                                  SmallImageSource="/Assets/Icons/video.png"/>
                    <RibbonButton x:Name="rbt_Cacthaotaccoban" Label="Các thao tác cơ bản" 
                                  SmallImageSource="/Assets/Icons/thaotac.png"/>
                </RibbonGroup>
                <RibbonGroup Header="Cập nhật">
                    <RibbonButton x:Name="rbt_Kiemtracapnhat" Label="Kiểm tra cập nhật" 
                                   SmallImageSource="/Assets/Icons/loading-arrow.png"/>
                    <RibbonButton x:Name="rbt_Capnhatmoi" Label="Cập nhật mới" 
                                   SmallImageSource="/Assets/Icons/update.png"/>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
    </Grid>
</UserControl>
